            "id": "1816418302",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"Archives\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:*\",\n      \"Resource\": [\n        \"arn:aws:s3:::ben-drucker-photos/*\",\n        \"arn:aws:s3:::ben-drucker-photos\",\n        \"arn:aws:s3:::ben-drucker-documents/*\",\n        \"arn:aws:s3:::ben-drucker-documents\"\n      ]\n    },\n    {\n      \"Sid\": \"IdentityCenter\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"sso:*\",\n        \"sso-directory:*\",\n        \"identitystore:*\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"Organizations\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"organizations:List*\",\n        \"organizations:Describe*\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"IdentityCenterProvisionedRoles\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:UpdateRoleDescription\",\n        \"iam:UpdateRole\",\n        \"iam:PutRolePolicy\",\n        \"iam:ListRolePolicies\",\n        \"iam:ListAttachedRolePolicies\",\n        \"iam:GetRole\",\n        \"iam:DetachRolePolicy\",\n        \"iam:DeleteRolePolicy\",\n        \"iam:DeleteRole\",\n        \"iam:CreateRole\",\n        \"iam:AttachRolePolicy\"\n      ],\n      \"Resource\": \"arn:aws:iam::278105230435:role/aws-reserved/sso.amazonaws.com/*\"\n    },\n    {\n      \"Sid\": \"IdentityCenterSAMLProvider\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"iam:GetSAMLProvider\",\n      \"Resource\": \"arn:aws:iam::278105230435:saml-provider/AWSSSO_*_DO_NOT_DELETE\"\n    },\n    {\n      \"Sid\": \"IdentityCenterListing\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:ListRoles\",\n        \"iam:ListPolicies\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"ManagedRoles\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:PassRole\",\n        \"iam:*RolePolicy*\",\n        \"iam:*Role*\"\n      ],\n      \"Resource\": \"arn:aws:iam::278105230435:role/managed/*\"\n    },\n    {\n      \"Sid\": \"DenySelfModification\",\n      \"Effect\": \"Deny\",\n      \"Action\": \"iam:*\",\n      \"Resource\": \"arn:aws:iam::278105230435:role/managed/terraform\"\n    },\n    {\n      \"Sid\": \"GitHubActionsProvider\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"iam:*OpenIDConnectProvider*\",\n      \"Resource\": \"arn:aws:iam::278105230435:oidc-provider/token.actions.githubusercontent.com\"\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"Archives\",\"Effect\":\"Allow\",\"Action\":\"s3:*\",\"Resource\":[\"arn:aws:s3:::ben-drucker-photos/*\",\"arn:aws:s3:::ben-drucker-photos\",\"arn:aws:s3:::ben-drucker-documents/*\",\"arn:aws:s3:::ben-drucker-documents\"]},{\"Sid\":\"IdentityCenter\",\"Effect\":\"Allow\",\"Action\":[\"sso:*\",\"sso-directory:*\",\"identitystore:*\"],\"Resource\":\"*\"},{\"Sid\":\"Organizations\",\"Effect\":\"Allow\",\"Action\":[\"organizations:List*\",\"organizations:Describe*\"],\"Resource\":\"*\"},{\"Sid\":\"IdentityCenterProvisionedRoles\",\"Effect\":\"Allow\",\"Action\":[\"iam:UpdateRoleDescription\",\"iam:UpdateRole\",\"iam:PutRolePolicy\",\"iam:ListRolePolicies\",\"iam:ListAttachedRolePolicies\",\"iam:GetRole\",\"iam:DetachRolePolicy\",\"iam:DeleteRolePolicy\",\"iam:DeleteRole\",\"iam:CreateRole\",\"iam:AttachRolePolicy\"],\"Resource\":\"arn:aws:iam::278105230435:role/aws-reserved/sso.amazonaws.com/*\"},{\"Sid\":\"IdentityCenterSAMLProvider\",\"Effect\":\"Allow\",\"Action\":\"iam:GetSAMLProvider\",\"Resource\":\"arn:aws:iam::278105230435:saml-provider/AWSSSO_*_DO_NOT_DELETE\"},{\"Sid\":\"IdentityCenterListing\",\"Effect\":\"Allow\",\"Action\":[\"iam:ListRoles\",\"iam:ListPolicies\"],\"Resource\":\"*\"},{\"Sid\":\"ManagedRoles\",\"Effect\":\"Allow\",\"Action\":[\"iam:PassRole\",\"iam:*RolePolicy*\",\"iam:*Role*\"],\"Resource\":\"arn:aws:iam::278105230435:role/managed/*\"},{\"Sid\":\"DenySelfModification\",\"Effect\":\"Deny\",\"Action\":\"iam:*\",\"Resource\":\"arn:aws:iam::278105230435:role/managed/terraform\"},{\"Sid\":\"GitHubActionsProvider\",\"Effect\":\"Allow\",\"Action\":\"iam:*OpenIDConnectProvider*\",\"Resource\":\"arn:aws:iam::278105230435:oidc-provider/token.actions.githubusercontent.com\"}]}",
